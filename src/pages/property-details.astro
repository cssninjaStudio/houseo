---
import Layout from '../layouts/Default.astro';
const title = 'Property Details'
---

<Layout title={title}>
  <div class="section">
    <div class="container">
      <div class="property-details-wrapper">
        <nav class="breadcrumb" aria-label="breadcrumbs">
          <ul>
            <li>
              <a href="#">
                <i class="iconify" data-icon="lucide:home"></i>
              </a>
            </li>
            <li><a href="#">Properties</a></li>
            <li><a href="#">Buy</a></li>
            <li class="is-active"><a href="#" aria-current="page">Details</a></li>
          </ul>
        </nav>

        <div class="property-details-title">
          <div class="left">
            <h2 class="title is-thin is-leading is-3">
              High standing luxury apartment
            </h2>
            <div>
              <a>
                <i class="iconify" data-icon="lucide:star"></i>
                <span>4,92 (263)</span>
              </a>

              <a>San Diego, CA</a>
            </div>
          </div>
          <div class="right">
            <a class="modal-trigger" data-modal="listing-share-modal">
              <i class="iconify" data-icon="lucide:share-2"></i>
              <span>Share</span>
            </a>
            <a class="modal-trigger" data-modal="listing-wishlist-modal">
              <i class="iconify" data-icon="lucide:heart"></i>
              <span>Save</span>
            </a>
          </div>
        </div>

        <div class="property-details-inner">
          <div class="start">
            <div class="property-images">
              <div class="main-image">
                <img
                  src="/img/photo/properties/details-1.jpg"
                  alt="Main image"
                  data-zoom
                />
              </div>
              <div class="sub-images">
                <img
                  src="/img/photo/properties/details-2.jpg"
                  alt="Sub image"
                  data-zoom
                />
                <img
                  src="/img/photo/properties/details-3.jpg"
                  alt="Sub image"
                  data-zoom
                />
                <img
                  src="/img/photo/properties/details-4.jpg"
                  alt="Sub image"
                  data-zoom
                />
              </div>
            </div>

            <div class="property-content" x-data="{ activeTab: 'tab-1' }">
              <div class="tabs">
                <ul>
                  <li :class="activeTab === 'tab-1' && 'is-active'">
                    <a @click.prevent="activeTab = 'tab-1'">Description</a>
                  </li>
                  <li :class="activeTab === 'tab-2' && 'is-active'">
                    <a @click.prevent="activeTab = 'tab-2'">Amenities</a>
                  </li>
                  <li :class="activeTab === 'tab-3' && 'is-active'">
                    <a @click.prevent="activeTab = 'tab-3'">Comments</a>
                  </li>
                </ul>
              </div>

              <div x-show="activeTab === 'tab-1'" class="tab-content">
                <p>
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quis
                  est tam dissimile homini. Sedulo, inquam, faciam. Quae cum
                  essent dicta, discessimus. Bona autem corporis huic sunt, quod
                  posterius posui, similiora. Qui ita affectus, beatum esse
                  numquam probabis; Restatis igitur vos; Duo Reges: constructio
                  interrete.
                </p>

                <p>
                  Quae cum essent dicta, discessimus. Bona autem corporis huic
                  sunt, quod posterius posui, similiora. Qui ita affectus, beatum
