---
import Layout from '../layouts/Default.astro';
const title = 'Quote'
---

<Layout title={title}>
  <div class="hero is-fullheight is-grey">
    <img
      class="wizard-cover"
      src="/img/illustrations/cityscape.svg"
      alt="Wizard cover"
    />

    <div class="hero-body">
      <div class="container">
        <div id="quote-section" class="form-section">
          <div class="container">
            <div x-data="initWizard()" class="outer-form">
              <div class="form-content has-text-centered">
                <div
                  id="form-section-0"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-0'
                            }"
                >
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      Let's get you a personalized quote
                    </h3>
                    <h4>Follow the instructions to enter the info we need</h4>
                  </div>
                  <div class="image-block">
                    <img src="/img/illustrations/quote.svg" alt="" />
                  </div>
                  <div class="button-block">
                    <button
                      @click="browseWizard($event)"
                      class="button is-primary raised wizard-button"
                      data-step="wizard-step-1"
                    >
                      Start
                    </button>
                  </div>
                </div>

                <div
                  id="form-section-1"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-1'
                            }"
                >
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      1. What's the project type?
                    </h3>
                    <h4>Please select a project type to proceed</h4>
                  </div>
                  <div class="content-block">
                    <div class="project-types">
                      <div class="radio-box">
                        <input
                          x-on:change="selectProjectType()"
                          type="radio"
                          name="project_type"
                        />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f1.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f1-dark.svg"
                            alt=""
                          />
                          <h3>House project</h3>
                          <p>I want my house to be reworked</p>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input
                          x-on:change="selectProjectType()"
                          type="radio"
                          name="project_type"
                        />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f5.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f5-dark.svg"
                            alt=""
                          />
                          <h3>Office project</h3>
                          <p>I want my office to be reworked</p>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input
                          x-on:change="selectProjectType()"
                          type="radio"
                          name="project_type"
                        />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f6.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f6-dark.svg"
                            alt=""
                          />
                          <h3>Store project</h3>
                          <p>I want my store to be reworked</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="button-block">
                    <button
                      @click="browseWizard($event)"
                      class="button is-primary raised wizard-button"
                      data-step="wizard-step-2"
                      :class="{
                                    'is-disabled': projectTypeSelected === false,
                                    '': projectTypeSelected === true
                                }"
                    >
                      Next
                    </button>
                  </div>
                </div>

                <div
                  id="form-section-2"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-2'
                            }"
                >
                  <div
                    @click="browseBackWizard($event)"
                    class="back-block"
                    data-step="wizard-step-1"
                  >
                    <i class="iconify" data-icon="feather:arrow-left"></i>
                  </div>
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      2. What do you need?
                    </h3>
                    <h4>Please select some services you need</h4>
                  </div>
                  <div class="content-block">
                    <div class="services-types">
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner is-flex">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f1.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f1-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Furniture design</h3>
                            <span>Handcrafted</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f7.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f7-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Decoration</h3>
                            <span>Homemade</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f8.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f8-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Light Works</h3>
                            <span>Illuminated</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f9.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f9-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Custom Windows</h3>
                            <span>Carbon fiber</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f10.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f10-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Custom Seats</h3>
                            <span>Alpaga</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f11.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f11-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Tables</h3>
                            <span>Fine woods</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f12.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f12-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Closets & Shelves</h3>
                            <span>Fine Woods</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f13.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f13-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Sound Design</h3>
                            <span>Hi Fi & Stereo</span>
                          </div>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input x-on:change="selectServices()" type="checkbox" />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f14.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f14-dark.svg"
                            alt=""
                          />
                          <div class="meta">
                            <h3>Kitchen Design</h3>
                            <span>Fully chromed</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="button-block">
                    <button
                      @click="browseWizard($event)"
                      class="button is-primary raised wizard-button"
                      data-step="wizard-step-3"
                      :class="{
                            'is-disabled': servicesSelected === false,
                            '': servicesSelected === true
                        }"
                    >
                      Next
                    </button>
                  </div>
                </div>

                <div
                  id="form-section-3"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-3'
                            }"
                >
                  <div
                    @click="browseBackWizard($event)"
                    class="back-block"
                    data-step="wizard-step-2"
                  >
                    <i class="iconify" data-icon="feather:arrow-left"></i>
                  </div>
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      3. What's your budget?
                    </h3>
                    <h4>Please select a budget range</h4>
                  </div>
                  <div class="content-block">
                    <div class="budget-types">
                      <div class="radio-box">
                        <input
                          x-on:change="selectBudget()"
                          type="radio"
                          name="budget_type"
                        />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f15.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f15-dark.svg"
                            alt=""
                          />
                          <h3>$0 - $10K</h3>
                          <p>A small but nice budget</p>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input
                          x-on:change="selectBudget()"
                          type="radio"
                          name="budget_type"
                        />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f16.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f16-dark.svg"
                            alt=""
                          />
                          <h3>$11K - $35K</h3>
                          <p>A considerable budget</p>
                        </div>
                      </div>
                      <div class="radio-box">
                        <input
                          x-on:change="selectBudget()"
                          type="radio"
                          name="budget_type"
                        />
                        <div class="radio-box-inner">
                          <div class="selection-dot gelatine">
                            <i class="iconify" data-icon="feather:check"></i>
                          </div>
                          <img
                            class="light-image-block"
                            src="/img/icons/f17.svg"
                            alt=""
                          />
                          <img
                            class="dark-image-block"
                            src="/img/icons/f17-dark.svg"
                            alt=""
                          />
                          <h3>$36K +</h3>
                          <p>Wohoo! You rock!</p>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="button-block">
                    <button
                      @click="browseWizard($event)"
                      class="button is-primary raised wizard-button"
                      data-step="wizard-step-4"
                      :class="{
                                    'is-disabled': budgetSelected === false,
                                    '': budgetSelected === true
                                }"
                    >
                      Next
                    </button>
                  </div>
                </div>

                <div
                  id="form-section-4"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-4'
                            }"
                >
                  <div
                    @click="browseBackWizard($event)"
                    class="back-block"
                    data-step="wizard-step-3"
                  >
                    <i class="iconify" data-icon="feather:arrow-left"></i>
                  </div>
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      4. What's your scope?
                    </h3>
                    <h4>Tell us more about your project</h4>
                  </div>
                  <div class="content-block">
                    <div class="project-scope">
                      <div class="field">
                        <div class="control">
                          <textarea
                            class="textarea"
                            placeholder="Describe your project..."
                          ></textarea>
                        </div>
                        <small>Minimum 5 words</small>
                      </div>

                      <div class="uploader-row">
                        <div class="uploaders">
                          <div class="uploader">
                            <input id="uploader-1" type="file" />
                            <label for="uploader-1" class="uploader-controls">
                              <i class="iconify" data-icon="feather:plus"></i>
                            </label>
                          </div>
                          <div class="uploader">
                            <input id="uploader-2" type="file" />
                            <label for="uploader-2" class="uploader-controls">
                              <i class="iconify" data-icon="feather:plus"></i>
                            </label>
                          </div>
                          <div class="uploader">
                            <input id="uploader-3" type="file" />
                            <label for="uploader-3" class="uploader-controls">
                              <i class="iconify" data-icon="feather:plus"></i>
                            </label>
                          </div>
                          <div class="uploader">
                            <input id="uploader-4" type="file" />
                            <label for="uploader-4" class="uploader-controls">
                              <i class="iconify" data-icon="feather:plus"></i>
                            </label>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="button-block">
                    <button
                      @click="browseWizard($event)"
                      class="button is-primary raised wizard-button"
                      data-step="wizard-step-5"
                    >
                      Next
                    </button>
                  </div>
                </div>

                <div
                  id="form-section-5"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-5'
                            }"
                >
                  <div
                    @click="browseBackWizard($event)"
                    class="back-block"
                    data-step="wizard-step-4"
                  >
                    <i class="iconify" data-icon="feather:arrow-left"></i>
                  </div>
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      5. Personal Info
                    </h3>
                    <h4>Let us know your contact details</h4>
                  </div>
                  <div class="content-block">
                    <div class="contact-details">
                      <div class="field">
                        <div class="control has-icon">
                          <input
                            type="text"
                            class="input"
                            placeholder="Full Name *"
                          />
                          <div class="form-icon">
                            <i class="iconify" data-icon="feather:user"></i>
                          </div>
                        </div>
                      </div>
                      <div class="field">
                        <div class="control has-icon">
                          <input
                            type="text"
                            class="input"
                            placeholder="Email *"
                          />
                          <div class="form-icon">
                            <i class="iconify" data-icon="feather:mail"></i>
                          </div>
                        </div>
                      </div>
                      <div class="field">
                        <div class="control has-icon">
                          <input
                            type="text"
                            class="input"
                            placeholder="Phone Number *"
                          />
                          <div class="form-icon">
                            <i class="iconify" data-icon="feather:phone"></i>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="button-block">
                    <button
                      @click="browseWizard($event)"
                      class="button is-primary raised wizard-button"
                      data-step="wizard-step-6"
                    >
                      Finish
                    </button>
                  </div>
                </div>

                <div
                  id="form-section-6"
                  class="inner-form"
                  :class="{
                                'is-active': activeWizardStep === 'wizard-step-6'
                            }"
                >
                  <div class="title-block">
                    <h3 class="title is-3 is-thin is-leading">
                      Congratz! We're done!
                    </h3>
                    <h4>You just finished entering all the info we need</h4>
                  </div>
                  <div class="content-block">
                    <div class="success-box">
                      <svg
                        class="SuccessAnimation is-primary animated"
                        xmlns="http://www.w3.org/2000/svg"
                        width="70"
                        height="70"
                        viewBox="0 0 70 70"
                      >
                        <path
                          class="SuccessAnimationResult"
                          fill="#D8D8D8"
                          d="M35,60 C21.1928813,60 10,48.8071187 10,35 C10,21.1928813 21.1928813,10 35,10 C48.8071187,10 60,21.1928813 60,35 C60,48.8071187 48.8071187,60 35,60 Z M23.6332378,33.2260427 L22.3667622,34.7739573 L34.1433655,44.40936 L47.776114,27.6305926 L46.223886,26.3694074 L33.8566345,41.59064 L23.6332378,33.2260427 Z"
                        />
                        <circle
                          class="SuccessAnimationCircle"
                          cx="35"
                          cy="35"
                          r="24"
                          stroke="#979797"
                          stroke-width="2"
                          stroke-linecap="round"
                          fill="transparent"
                        />
                        <polyline
                          class="SuccessAnimationCheck"
                          stroke="#979797"
                          stroke-width="2"
                          points="23 34 34 43 47 27"
                          fill="transparent"
                        />
                      </svg>
                      <h3 class="success-title">Application registered</h3>
                      <p class="success-text">
                        We've registered your project. One of our counselors will
                        get in touch with you very soon.
                      </p>
                    </div>
                  </div>
                  <div class="button-block is-vhidden">
                    <button
                      class="button is-primary raised wizard-button is-disabled"
                    >
                      End
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
