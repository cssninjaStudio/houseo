---
import Layout from '../layouts/Default.astro'
const title = 'Settings'
---

<Layout title={title}>
  <div class="section">
    <div class="container">
      <div class="account-app">
        <div class="account-header">
          <img class="header-avatar" src="/img/avatars/4.jpg" alt="avatar" />
          <div class="header-meta">
            <h2 class="title is-3 is-thin">Personal Info</h2>
            <h4 class="subtitle is-5 stressed-1">Edit your personal details</h4>
          </div>
        </div>

        <div class="account-layout py-6">
          <div class="columns b-flex-tablet-p">
            <div class="column is-7">
              <div class="account-block">
                <div class="mb-6">
                  <h2 class="title is-5 is-normal">General</h2>
                  <h4 class="subtitle is-6">Your general information and details</h4>
                </div>

                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Full Name</span>
                    <span class="is-block">Henry Miller</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Gender</span>
                    <span class="is-block">Male</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Email Address</span>
                    <span class="is-block">henrymiller@gmail.com</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Birthdate</span>
                    <span class="is-block">August 24, 1984</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
              </div>

              <div class="account-block">
                <div class="mt-6 mb-6">
                  <h2 class="title is-5 is-normal">Additional Info</h2>
                  <h4 class="subtitle is-6">some additional details that we need</h4>
                </div>

                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Phone Number</span>
                    <span class="is-block">(+1) 555 551 54984</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">ID Document</span>
                    <span class="is-block">Successfully uploaded</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Location</span>
                    <span class="is-block">San Francisco, CA</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
                <!--Setting block-->
                <article class="media">
                  <div class="media-content">
                    <span class="is-block">Emergency</span>
                    <span class="is-block">Your emergency infos</span>
                  </div>
                  <div class="media-right">
                    <a class="default-link">Edit</a>
                  </div>
                </article>
              </div>
            </div>
            <div class="column is-4 is-offset-1">
              <!--Categories-->
              <div class="account-categories">
                <!--Category-->
                <a href="/account" class="card mb-5">
                  <div class="card-content">
                    <div class="card-icon">
                      <iconify-icon class="iconify text-success" icon="ph:shield-check-duotone"></iconify-icon>
                    </div>
                    <h3 class="title is-6 has-space">
                      <span class="icon-text">
                        <span>Account & Security</span>
                        <span class="icon">
                          <i data-feather="chevron-right"></i>
                        </span>
                      </span>
                    </h3>
                    <p class="stressed-1 is-md">Update your password and secure your account. You can also enable two-factor authentication.</p>
                  </div>
                </a>
                <!--Category-->
                <a href="/account" class="card">
                  <div class="card-content">
                    <div class="card-icon">
                      <iconify-icon class="iconify text-info" icon="ph:credit-card-duotone"></iconify-icon>
                    </div>
                    <h3 class="title is-6 has-space">
                      <span class="icon-text">
                        <span>Payments</span>
                        <span class="icon">
                          <i data-feather="chevron-right"></i>
                        </span>
                      </span>
                    </h3>
                    <p class="stressed-1 is-md">View your payments and your transactions. Also view coupon codes, gift cards and tax reports.</p>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
