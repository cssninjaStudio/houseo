---
import Layout from '../layouts/Default.astro';
const title = 'Properties'
---

<Layout title={title}>
  <div class="hero is-grey search-hero">
    <div class="hero-body">
      <div class="container">
        <div class="columns is-vcentered">
          <div class="column is-12">
            <div class="hero-search-centered">
              <div class="has-text-centered">
                <h1 class="title is-1 is-thin">Explore Properties</h1>
                <h2 class="subtitle is-5">
                  We help you find the perfect space for you and your family.
                </h2>
              </div>
              <div class="hero-search" x-data="{ activeTab: 'buy' }">
                <div class="tabs is-boxed">
                  <ul>
                    <li :class="activeTab === 'buy' && 'is-active'">
                      <a @click.prevent="activeTab = 'buy'">
                        <span>Buy</span>
                      </a>
                    </li>
                    <li :class="activeTab === 'rent' && 'is-active'">
                      <a @click.prevent="activeTab = 'rent'">
                        <span>Rent</span>
                      </a>
                    </li>
                  </ul>
                </div>
                <div class="search-bar">
                  <div class="search-bar-inner">
                    <div class="control has-icon">
                      <div class="select">
                        <select>
                          <option>Property type</option>
                          <option>Private residence</option>
                          <option>Private house</option>
                          <option>Apartment</option>
                          <option>Mansion</option>
                        </select>
                        <div class="form-icon">
                          <i class="iconify" data-icon="lucide:home"></i>
                        </div>
                      </div>
                    </div>
                    <div class="control has-icon">
                      <input
                        type="text"
                        class="input"
                        placeholder="Search by location"
                      />
                      <div class="form-icon">
                        <i class="iconify" data-icon="lucide:search"></i>
                      </div>
                    </div>
                    <div class="control">
                      <button type="button" class="button is-primary raised">
                        Search
                      </button>
                    </div>
                  </div>
                </div>

                <div class="search-bar-settings">
                  <label for="new-properties" class="f-switch is-primary">
                    <input id="new-properties" type="checkbox" />
                    <i></i>
                  </label>

                  <p>Only include new properties</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

