---
import Layout from '../layouts/Split.astro'
const title = 'Home'
---

<Layout title={title}>
  <div class="hero is-grey is-fullheight search-hero">
    <div class="hero-cover columns is-gapless">
      <div class="column">
        <div class="cover-block"></div>
      </div>
      <div class="column">
        <div class="cover-block" data-background="/img/photo/hero/3.jpg"></div>
      </div>
    </div>

    <div class="hero-body">
      <div class="container">
        <div class="columns is-vcentered">
          <div class="column is-8">
            <div class="hero-caption">
              <h1 class="title is-1 is-thin is-spaced">Find the house of your dreams.</h1>
              <h2 class="subtitle is-5">We help you find the perfect space that will make you and your family happy.</h2>
            </div>
            <div class="hero-search" x-data="{ activeTab: 'buy' }">
              <div class="tabs is-boxed">
                <ul>
                  <li :class="activeTab === 'buy' && 'is-active'">
                    <a @click.prevent="activeTab = 'buy'">
                      <span>Buy</span>
                    </a>
                  </li>
                  <li :class="activeTab === 'rent' && 'is-active'">
                    <a @click.prevent="activeTab = 'rent'">
                      <span>Rent</span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="search-bar">
                <div class="search-bar-inner">
                  <div class="control has-icon">
                    <div class="select">
                      <select>
                        <option>Property type</option>
                        <option>Private residence</option>
                        <option>Private house</option>
                        <option>Apartment</option>
                        <option>Mansion</option>
                      </select>
                      <div class="form-icon">
                        <iconify-icon class="iconify" icon="lucide:home"></iconify-icon>
                      </div>
                    </div>
                  </div>
                  <div class="control has-icon">
                    <input type="text" class="input" placeholder="Search by location" />
                    <div class="form-icon">
                      <iconify-icon class="iconify" icon="lucide:search"></iconify-icon>
                    </div>
                  </div>
                  <div class="control">
                    <button type="button" class="button is-primary raised"> Search </button>
                  </div>
                </div>
              </div>

              <div class="search-bar-settings">
                <label for="new-properties" class="f-switch is-primary">
                  <input id="new-properties" type="checkbox" />
                  <i></i>
                </label>

                <p>Only include new properties</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

