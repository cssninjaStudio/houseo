---
import AccountMenu from '../components/AccountMenu.astro'
import AccountMenuMobile from '../components/AccountMenuMobile.astro'
import Megamenu from '../components/Megamenu.astro'
---

<div
  x-data="initNavbar()"
  x-on:scroll.window="scroll()"
  x-init="initScrollAnchors()"
  x-on:mouseleave="megamenuOpened = false"
  class="navbar is-transparent is-fixed-top"
  role="navigation"
  aria-label="main navigation"
  :class=`{
      'is-scrolled': scrolled,
      '': !scrolled,
      'is-solid': mobileOpen || megamenuOpened,
      '': !mobileOpen || !megamenuOpened,
  }`
>
  <div class="container">
    <div class="navbar-brand">
      <a class="navbar-item" href="/">
        <img src="/img/logo/logo.svg" alt="" />
        <span class="logo-text">Houseo</span>
      </a>

      <div class="navbar-burger" @click="openMobileMenu()">
        <div class="menu-toggle">
          <div class="icon-box-toggle is-navbar" :class=`{
                'active': mobileOpen,
                '': !mobileOpen
            }`>
            <div class="rotate">
              <i class="icon-line-top"></i>
              <i class="icon-line-center"></i>
              <i class="icon-line-bottom"></i>
            </div>
          </div>
        </div>
      </div>

      <template x-if="$store.app.isLoggedIn">
        <AccountMenuMobile />
      </template>
    </div>

    <div class="navbar-menu" :class=`{
          'is-active': mobileOpen,
          '': !mobileOpen
      }`>
      <div class="navbar-start">
        <a class="navbar-item" x-on:mouseover="megamenuOpened = true, openedMegamenu = 'megamenu-1'">
          <span>Properties</span>
          <iconify-icon class="iconify caret" icon="lucide:chevron-down"></iconify-icon>
        </a>
        <a class="navbar-item" x-on:mouseover="megamenuOpened = true, openedMegamenu = 'megamenu-2'">
          <span>Rentals</span>
          <iconify-icon class="iconify caret" icon="lucide:chevron-down"></iconify-icon>
        </a>
        <a href="/about" class="navbar-item"> About </a>
      </div>

      <div class="navbar-end">
        <template x-if="$store.app.isLoggedIn === false">
          <a href="/login" class="navbar-item is-end-bordered"> Sign In </a>
        </template>

        <a href="/properties" class="navbar-item is-icon">
          <iconify-icon class="iconify" icon="lucide:search"></iconify-icon>
        </a>
        <a href="/wishlist" class="navbar-item is-icon">
          <iconify-icon class="iconify" icon="lucide:heart"></iconify-icon>
        </a>
        <div class="navbar-item is-mobile-centered">
          <label class="theme-toggle">
            <input type="checkbox" x-on:change="toggleTheme()" />
            <span class="theme-toggle-inner">
              <iconify-icon class="sun-icon iconify" icon="lucide:sun"></iconify-icon>
              <iconify-icon class="moon-icon iconify" icon="lucide:moon"></iconify-icon>
            </span>
          </label>
        </div>

        <template x-if="$store.app.isLoggedIn === false">
          <div class="navbar-item">
            <a href="/signup" class="button navbar-button is-primary raised"> Register </a>
          </div>
        </template>

        <template x-if="$store.app.isLoggedIn">
          <div class="navbar-item">
            <AccountMenu />
          </div>
        </template>
      </div>
    </div>
  </div>

  <Megamenu />
</div>
